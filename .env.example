# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

# Required: Your OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Optional: GPT Model (default: gpt-4)
# Options: gpt-4, gpt-4-turbo, gpt-4o, gpt-3.5-turbo
model=gpt-4

# ----- AssemblyAI Speaker Diarization (OPTIONAL FEATURE)
# Enable speaker diarization in transcriptions
# Get your API key from: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
ENABLE_ASSEMBLYAI_DIARIZATION=false
ASSEMBLYAI_LANGUAGE_CODE=en
# Set to True to require users to provide their own AssemblyAI keys in Settings
# Set to False to use the system ASSEMBLYAI_API_KEY above
REQUIRE_ASSEMBLYAI_KEY=True

# ----- L2.S1 character tracking (enrichment)
# L2_CHARACTER_TRACKING — which S1 path to use (default: continuous)
#   continuous | sparse
#   aliases for sparse: sample | observation
#   continuous = YOLOv11 + ByteTrack + ArcFace (falls back to sparse if deps fail / no overlap)
#   sparse     = utterance-sampled face observation only (character_observation_v1)
L2_CHARACTER_TRACKING=continuous
#
# L2_TRACKING_FRAME_STRIDE — analyze every Nth video frame (continuous only; default: 2)
#   positive integer, e.g. 1 | 2 | 5 | 10
#   higher = faster / fewer samples; 1 = every frame
L2_TRACKING_FRAME_STRIDE=5
#
# L2_TRACKING_MAX_FRAMES — stop after this many video frames from the start (continuous only)
#   unset / empty = full video | positive integer, e.g. 300 | 1000 | 1200
#   ignored when L2_CHARACTER_TRACKING=sparse
# L2_TRACKING_MAX_FRAMES=300
#
# L2_TRACKING_DEVICE — inference device for YOLO / ArcFace (continuous only; default: cpu)
#   cpu | cuda | cuda:0 | mps  (use what your torch/ultralytics build supports)
L2_TRACKING_DEVICE=cpu

# ----- Scene / event understanding (pre-recap GPT-4o vision)
# ENABLE_SCENE_UNDERSTANDING — run visual scene describe before recap (default: false)
#   true | false | 1 | 0 | yes | no | on | off
# ENABLE_SCENE_UNDERSTANDING=false
#
# SCENE_BOUNDARY_MODE — how to choose describe windows (default: fixed)
#   fixed         = sample at SCENE_SAMPLE_FPS, chunk by SCENE_BATCH_FRAMES (uniform time)
#   pyscenedetect = PySceneDetect ContentDetector shots, merge short shots into scenes,
#                   then sample up to SCENE_BATCH_FRAMES frames inside each merged scene
# SCENE_BOUNDARY_MODE=fixed
#
# SCENE_DETECT_THRESHOLD — ContentDetector threshold (pyscenedetect only; default: 27)
#   lower = more cuts; higher = fewer cuts
# SCENE_DETECT_THRESHOLD=27
#
# SCENE_MIN_DURATION_SEC — merge shots shorter than this into neighbors (default: 4)
# SCENE_MIN_DURATION_SEC=4
#
# SCENE_MAX_DURATION_SEC — prefer not to grow a merged scene past this (default: 45)
# SCENE_MAX_DURATION_SEC=45
#
# SCENE_VISION_MODEL — vision-capable OpenAI model (default: gpt-4o)
#   gpt-4o | gpt-4o-mini | gpt-4.1 | …
# SCENE_VISION_MODEL=gpt-4o
#
# SCENE_SAMPLE_FPS — frames per second to sample (default: 0.5 = one frame every 2s)
#   positive float, e.g. 0.25 | 0.5 | 1.0 | 2.0
# SCENE_SAMPLE_FPS=0.5
#
# SCENE_BATCH_FRAMES — fixed mode: frames per vision call; pyscenedetect: max frames per scene
#   positive integer, e.g. 4 | 8 | 10
# SCENE_BATCH_FRAMES=8
#
# SCENE_MAX_DURATION — only analyze first N seconds (empty = full video)
#   unset | positive float, e.g. 60
# SCENE_MAX_DURATION=

# ----- User API Keys (OpenAI)
# Allow specific users to provide their own OpenAI API keys instead of using system key
ENABLE_USER_API_KEYS=false
# Comma-separated list of email addresses allowed to use their own OpenAI keys
API_KEY_ALLOWED_EMAILS=[]

# ----- Docker Compose / Celery pipeline
# Uncomment for localhost debugging (keeps /tmp/recap_<job>_.../output after each job)
# DEBUG=true
# KEEP_PIPELINE_WORKING_DIR=true

# ----- Recap target duration (seconds)
# Controls upload form range and JobConfig API validation (exposed via GET /api/v1/meta)
MIN_TARGET_DURATION_SECONDS=10
MAX_TARGET_DURATION_SECONDS=300
